<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\RemoteDesk\Scadex.RemoteDesk\Scadex.RemoteDesk.csproj" />
    <ProjectReference Include="..\Scadex.Business\Scadex.Business.csproj" />
    
	<!-- MODULES -->
    <ProjectReference Include="..\Scadex.Signalization\Scadex.Signalization.csproj" />
    <!-- MODULES -->
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg ve MediaMTX ContentRootPath altindan calistirilir (MediaGateway:FfmpegPath / MediaMtxPath): gelistirmede proje klasorunden okunur, bin'e kopyalanmaz; yalnizca publish ciktisina girer. -->
    <None Update="MediaTools\ffmpeg\*" CopyToPublishDirectory="PreserveNewest" />
    <None Update="MediaTools\mediamtx\*" CopyToPublishDirectory="PreserveNewest" />
    <!-- Map Tile, /basemap altindan publish edilir. -->
    <None Update="MapTiles\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

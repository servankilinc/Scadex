{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=Scadex;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
    // "Database": "Server=127.0.0.1,1433; Database=Scadex; User Id=sa; Password=Bmce4456; TrustServerCertificate=True;"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "TokenSettings": {
    "Audience": "Scadex.com",
    "Issuer": "Scadex.com",
    "AccessTokenExpiration": 1440,
    "RefreshTokenExpiration": 10080,
    "SecurityKey": "ugFHF1+AqbEVS/yZCH1TyEec4UbKg53eGn4FNcaDsqgOevhH4uZ+9yivTiHg7XbecrSxwaohIFKhj0NG6bJGjA==",
    "RefreshTokenTTL": 7
  },
  "CacheSettings": {
    "SlidingExpirationMinutes": 30,
    "AbsoluteExpirationMinutes": 120
  },
  "Scada": {
    // Kabin durum taramasi (StatusCleanupWorker) turu: izlemesi kapali cihaz/kameralarin 23 saatten
    // eski durumunu "bilinmiyor"a ceker ve tum kabinleri uzlastirir. LastSeen'e bakip Offline'a CEKMEZ;
    // 23 saat bilerek sabittir (CabinetStatusService.Sweep).
    "SweepIntervalSeconds": 300 // 5 dk
  },
  "Monitoring": {
    // IMonitoredAsset varliklarinin yoklama turu. Periyot VARLIK BASINADIR
    // (PingIntervalSec); bu deger yalnizca "ne siklikla bakilip periyodu dolan
    // var mi diye kontrol edilecegi"dir, o yuzden en kisa periyottan kucuk olmali.
    "SweepIntervalSeconds": 30,
    // Tek bir TCP connect denemesinin zaman asimi.
    "ProbeTimeoutMs": 3000
  },
  "Jobs": {
    // Birikmis canli izleme yollarinin gunluk temizlik saati (0-23, yerel saat).
    // Izleyicisi olan ve kayit yapan yollara DOKUNULMAZ.
    "MediaPathCleanupHour": 3,
    // Saklama suresi dolmus cekim DOSYALARININ silinme saati (0-23, yerel saat).
    "CaptureRetentionSweepHour": 4
  },
  "MediaGateway": {
    // MediaMTX'i Scadex baslatir ve kapanirsa yeniden baslatir; MediaMTX exe ile ayni klasordeki mediamtx.yml'yi okur.
    // Port/adres alanlari mediamtx.yml ile manuel senkron tutulur. Degisiklik Scadex'in yeniden baslatilmasini gerektirir.
    "ApiBaseUrl": "http://127.0.0.1:9997", // = mediamtx.yml > apiAddress
    "RtspPort": 8554, // = mediamtx.yml > rtspAddress (FFmpeg 127.0.0.1:<port>'tan okur)
    "WebRtcPublicBaseUrl": "http://127.0.0.1:8889", // tarayicinin WHEP adresi; portu = mediamtx.yml > webrtcAddress (onde proxy yoksa)
    "FfmpegPath": "MediaTools/ffmpeg/ffmpeg.exe", // goreliyse ContentRootPath'e gore; mutlak yol da olur
    "MediaMtxPath": "MediaTools/mediamtx/mediamtx.exe", // ayni kural; yml = exe ile ayni klasordeki mediamtx.yml
    "ApiTimeoutMs": 30000,
    "TokenTtlSeconds": 60, // izleme/cekim biletinin omru
    "SourceOnDemandCloseAfterSec": 10, // son izleyici ayrildiktan sonra kameraya giden RTSP oturumunun kapanma suresi
    "RtspTransport": "tcp" // kamera -> MediaMTX: tcp | udp | multicast | automatic
  },
  "Modules": {
    "Signalization": {
      "Enabled": true
    }
  },
  "LocalizationSettings": {
    "DefaultLanguage": "tr-TR",
    "AvailableLanguages": [
      "tr-TR",
      "en-US"
    ]
  },
  "AllowedHosts": "*"
}

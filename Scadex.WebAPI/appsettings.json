{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=Scadex;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
    //"Database": "Server=127.0.0.1,1433; Database=Scadex; User Id=sa; Password=Bmce4456; TrustServerCertificate=True;"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "TokenSettings": {
    "Audience": "Scadex.com",
    "Issuer": "Scadex.com",
    "AccessTokenExpiration": 1440,
    "RefreshTokenExpiration": 10080,
    "SecurityKey": "ugFHF1+AqbEVS/yZCH1TyEec4UbKg53eGn4FNcaDsqgOevhH4uZ+9yivTiHg7XbecrSxwaohIFKhj0NG6bJGjA==",
    "RefreshTokenTTL": 7
  },
  "CacheSettings": {
    "SlidingExpirationMinutes": 30,
    "AbsoluteExpirationMinutes": 120
  },
  "Scada": {
    // Bu kadar saniyedir haber alinamayan cihaz Offline'a cekilir. SCADA'nin
    // gonderim periyodundan BELIRGIN sekilde buyuk olmali; aksi halde tek bir
    // gecikmis paket cihazi Offline/Online arasinda sallandirir.
    "StaleAfterSeconds": 86400, // 1 gün
    "SweepIntervalSeconds": 300 // 5 dk
  },
  "Monitoring": {
    // IMonitoredAsset varliklarinin yoklama turu. Periyot VARLIK BASINADIR
    // (PingIntervalSec); bu deger yalnizca "ne siklikla bakilip periyodu dolan
    // var mi diye kontrol edilecegi"dir, o yuzden en kisa periyottan kucuk olmali.
    "SweepIntervalSeconds": 30,
    // Tek bir TCP connect denemesinin zaman asimi.
    "ProbeTimeoutMs": 3000
  },
  "MediaGateway": {
    "ApiTimeoutMs": 30000,
    // Control API — yol yazmak icin. LOOPBACK olmali: bu uc kimlik
    // dogrulamasizdir ve disariya acilirsa herkes kamera yolu tanimlayabilir.
    "ApiBaseUrl": "http://127.0.0.1:9997",
    // WebRTC/WHEP — TARAYICININ ulasacagi adres, sunucunun degil. Backend ile
    // tarayici ayri makinedeyse 127.0.0.1 CALISMAZ; sunucunun LAN adresini yazin.
    "WebRtcPublicBaseUrl": "http://127.0.0.1:8889",
    // Biletin omru. Yalnizca el sikisma aninda kullanildigi icin kisa tutuluyor (bir token çok kullanımlıktır).
    "TokenTtlSeconds": 60,
    // Son izleyici ayrildiktan sonra kameraya olan RTSP oturumunun kapanma suresi.
    "SourceOnDemandCloseAfter": "10s",
    // UDP paket kaybi H.264 akisinda kalici bozulma birakir.
    "RtspTransport": "tcp",
    // MediaMTX'in klip segmentlerini yazdigi gecici kok.
    // MediaMTX ile bu uygulama AYNI dosya sistemini gormek zorunda.
    "RecordRoot": "C:\\Scadex\\mediamtx-records"
  },
  "Cameras": {
    "SnapshotTimeoutMs": 5000,
    // Es zamanli isteklerin kameraya tek istek uretmesi icin kisa onbellek.
    "SnapshotCacheSeconds": 3,
    // wwwroot altindaki cekim koku — sablon gorselleriyle ayni desen.
    "CaptureRoot": "uploads/captures",
    // CameraCapture.ExpiresAt bu degerden hesaplanir; 0 = suresiz.
    // DIKKAT: bu kolona bakan bir temizlik isi YOKTUR, sure gecince dosya silinmez.
    "CaptureRetentionDays": 30,
    "MaxClipDurationSec": 120,
    // Kayit baslarken/kapanirken MediaMTX'e taninan pay.
    "ClipFinalizeGraceMs": 3000
  },
  "LocalizationSettings": {
    "DefaultLanguage": "tr-TR",
    "AvailableLanguages": [
      "tr-TR",
      "en-US"
    ]
  },
  "AllowedHosts": "*"
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    IIS'e özel ayarlar. dotnet publish bu dosyaya aspNetCore/handlers bölümünü kendisi ekler; burada yalnızca onun üretmediği şeyler durur.
    Kestrel ile (dotnet run) çalışırken okunmaz.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!--
            IIS istek filtrelemesinin varsayılanı 30.000.000 bayttır: ~28,6 MB üstü her gövde IIS'te 404.13 ile kesilir, uygulamaya hiç
            ulaşmaz ([DisableRequestSizeLimit] bunu aşmaz). RemoteDesk dosya transferinin sınırı 1 GB'tır (FileTransferStore.MaxBytes,
            akışta zorlanır); burası 1 GB + 1 MB pay. Sınırı değiştirirseniz ikisini birlikte değiştirin.
          -->
          <requestLimits maxAllowedContentLength="1074790400" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>

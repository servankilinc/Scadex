<UserControl x:Class="Scadex.RemoteDesk.Windows.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Scadex.RemoteDesk.Windows.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HomeVM}"
             d:DesignHeight="700" d:DesignWidth="960"
             Background="#F4F6F9" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2933">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE2E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7580" />
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- İzleniyor: merkez bu PC'nin ekranını yayınlatıyorken belirgin uyarı (izleme fark edilmeden yapılmaz). -->
            <Border Background="#C5221F" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding Connection.IsWatching, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Connection.WatchingText}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- Merkez bağlantısı -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Connection}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Yeniden bağlan" Command="{Binding ReconnectCommand}" Margin="0" />
                        <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding StateBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Value}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding MatchedText}" Style="{StaticResource Value}" FontWeight="SemiBold"
                               Visibility="{Binding HasMatched, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Merkez" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CentralUrl}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Text="Bilgisayar" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineName}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="2" Text="MAC adresleri" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding Adapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <!-- Seçilebilir: teknisyen kopyalayıp diyagrama yapıştırır. -->
                                            <TextBox Text="{Binding DisplayMac, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     FontFamily="Consolas" Padding="0" Width="140" />
                                            <TextBlock Foreground="#6B7580">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Description, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="MAC'leri kopyala" Command="{Binding CopyMacsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Başlık: FFmpeg ve donanım -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Monitörleri yenile" Command="{Binding RefreshCommand}" Margin="0" />
                        <TextBlock Text="Scadex RemoteDesk — saha kontrolü" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding MachineText}" Style="{StaticResource Value}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding FfmpegText}" Style="{StaticResource Value}" Foreground="#6B7580" />
                    <TextBlock Text="{Binding FfmpegWarning}" Style="{StaticResource Value}" Foreground="#C78A10" FontWeight="SemiBold"
                               Visibility="{Binding HasFfmpegWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Encoder: sınama + aday listesi + PC tercihi (monitörlerden ayrı) -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Encoder}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Encoder'ları sına" Command="{Binding ProbeCommand}" Margin="0" />
                        <TextBlock Text="Encoder" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Otomatik seçime dön" Command="{Binding ResetPreferenceCommand}" Margin="8,0,0,0"
                                Visibility="{Binding HasPreference, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PreferenceText}" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Value}" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EncoderRowVM}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Symbol}" Foreground="{Binding SymbolBrush}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Encoder}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Chain}" Foreground="#6B7580" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E3F1E8"
                                            CornerRadius="3" Padding="6,0"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="SEÇİLDİ" Foreground="#2E9E5B" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <Button Grid.Column="4" Content="Tercih et" Command="{Binding PreferCommand}" Padding="8,1" Margin="10,0,0,2"
                                            FontSize="12" Visibility="{Binding CanPrefer, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Bu PC'deki tüm yayınlar bu encoder'ı kullanır; çalışan yayın yeniden başlar. Uygulama kapanınca otomatik seçime döner." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Monitör kartları: merkezin yayınının salt okunur durumu -->
            <ItemsControl ItemsSource="{Binding Monitors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitorVM}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Geometry}" Foreground="#6B7580" />
                                <TextBlock Text="{Binding Gpu}" Foreground="#6B7580" TextWrapping="Wrap" />

                                <TextBlock Text="Yayın" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Durum" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="1" Text="Encoder" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EncoderText}" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="2" Text="Profil" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileText}" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="3" Text="Canlı" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LiveText}" Foreground="{Binding LiveBrush}" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="4" Text="Hedef" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TargetText}" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="5" Text="Not" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MessageText}" Foreground="#C78A10" Style="{StaticResource Value}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Yalnızca System Tray ikonu (NotifyIcon) için; üçüncü parti paket yok. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport (Job Object P/Invoke) üretilen kodda unsafe kullanır. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- WinForms'un örtük using'leri WPF adlarıyla çakışır (Application, MessageBox, Brush, Color…); System Tray kodu tam adla yazar. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
	<None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
  </ItemGroup>

  <ItemGroup>
	<Compile Update="Views\Home.xaml.cs">
		<SubType>Code</SubType>
	</Compile>
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- LGPL build tools\ffmpeg altına elle konur veya varsa publish'e kopyalanır; uygulama sabit yerde arar: <uygulama>\tools\ffmpeg\ffmpeg.exe (FfmpegLocator). -->
  <ItemGroup>
    <!-- Oturum açılışında yükseltilmiş başlatma görevini kuran betik; publish klasörüyle birlikte dağıtılır (RemoteDesk.md § 9.6, § 12.6). -->
    <None Update="Deploy\Install-StartupTask.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lisans exe ile birlikte dağıtılmak zorunda. -->
    <None Update="tools\ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- tools\ffmpeg git'te yok; eksikse publish klasörü yayın yapamayan bir istemci olurdu — sahaya gitmeden dursun. -->
  <Target Name="RequireFfmpegForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('tools\ffmpeg\ffmpeg.exe') Or !Exists('tools\ffmpeg\LICENSE.txt')"
           Text="tools\ffmpeg\ffmpeg.exe ya da LICENSE.txt eksik. LGPL FFmpeg build'ini (sunucudaki MediaTools\ffmpeg ile aynı) bu klasöre koyun; GPL build koymayın." />
  </Target>


  <ItemGroup>
    <ProjectReference Include="..\Scadex.RemoteDesk.Contracts\Scadex.RemoteDesk.Contracts.csproj" />
  </ItemGroup>

</Project>

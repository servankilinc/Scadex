<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Tek exe, iki mod:
      (argümansız)  Windows servisi — Session 0, LocalSystem; yalnızca gözetmen: kullanıcı oturumunda Agent'ı başlatır/yeniden başlatır.
      - -session    Agent — kullanıcının oturumunda, SYSTEM kimliğiyle; merkez hub'ı, ekran yakalama, girdi, dosya, pano.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Yalnızca panonun STA iş parçacığı için (System.Windows.Forms.Clipboard); pencere açılmaz. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport (Job Object, WTS, token, SendInput P/Invoke) üretilen kodda unsafe kullanır. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Per-Monitor DPI Aware v2: monitör dikdörtgenleri ve SendInput koordinatları fiziksel piksel. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Scadex.RemoteDesk.Windows.Service</AssemblyName>
  </PropertyGroup>

  <!-- WinForms'un örtük using'leri BCL adlarıyla çakışır; pano kodu tam adla yazar. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scadex.RemoteDesk.Contracts\Scadex.RemoteDesk.Contracts.csproj" />
  </ItemGroup>

  <!-- LGPL build tools\ffmpeg altına elle konur; uygulama sabit yerde arar: <uygulama>\tools\ffmpeg\ffmpeg.exe (FfmpegLocator). -->
  <ItemGroup>
    <None Update="tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lisans exe ile birlikte dağıtılmak zorunda. -->
    <None Update="tools\ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- tools\ffmpeg git'te yok; eksikse publish klasörü yayın yapamayan bir Agent olurdu — sahaya gitmeden dursun. -->
  <Target Name="RequireFfmpegForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('tools\ffmpeg\ffmpeg.exe') Or !Exists('tools\ffmpeg\LICENSE.txt')"
           Text="tools\ffmpeg\ffmpeg.exe ya da LICENSE.txt eksik. LGPL FFmpeg build'ini (sunucudaki MediaTools\ffmpeg ile aynı) bu klasöre koyun; GPL build koymayın." />
  </Target>

</Project>
